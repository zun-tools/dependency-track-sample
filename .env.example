# 使うときだけ .env にコピーして書く（.env はコミットしない）。どれも省略できます。
# compose.yaml が読む物（docker compose が .env を自動で読みます）
# DT_API_PORT=8080
# DT_UI_PORT=8081
# DT_DB_PASSWORD=dtrack

# scripts/ が読む物。秘密なのでファイルに書かず、シェルの環境変数で渡すのがおすすめです
# DT_ADMIN_PASSWORD=       # scripts/setup.sh だけが使う。admin の新しいパスワード（自分で決める）
# DT_API_KEY=              # setup.sh が出力する Automation チームの API キー（odt_ で始まる）
